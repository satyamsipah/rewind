{
  "name": "rewind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --workspace vitest.workspace.ts",
    "test:unit": "vitest run --workspace vitest.workspace.ts --project unit",
    "test:integration": "vitest run --workspace vitest.workspace.ts --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:rebuild-projections": "tsx scripts/rebuild-projections.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.4",
    "drizzle-orm": "^0.38.3",
    "next": "^15.1.3",
    "next-auth": "^5.0.0-beta.25",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.15",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-kit": "^0.30.1",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8"
  }
}
