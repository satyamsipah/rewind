# Copy this file to .env for local development (`.env` is gitignored —
# see the "Final sweep" note in docs/DECISIONS.md for how that's verified
# never to have been committed). On Vercel, set these as Project Settings
# → Environment Variables instead of a committed file.

# --- Database -----------------------------------------------------------
# Postgres connection string. Any real Postgres works locally (see
# README.md "Development") or PGlite is used automatically by the
# integration test suite (no setup needed for `pnpm test`). Production: a
# Neon or Render Postgres connection string (CLAUDE.md "Deploy: Vercel +
# Neon/Render Postgres").
DATABASE_URL=postgres://user:password@localhost:5432/rewind

# --- Auth.js v5 (lib/auth/config.ts) ------------------------------------
# Signs and encrypts session cookies. Generate one with:
#   npx auth secret
# or:
#   openssl rand -base64 32
# Never reuse a dev value in production, and never commit a real one.
AUTH_SECRET=

# The canonical URL Auth.js constructs OAuth callback/redirect URLs from.
# Optional in production on Vercel — lib/auth/config.ts sets
# `trustHost: true`, which derives it from the incoming request's Host
# header instead (see docs/DECISIONS.md "Auth: trust the request host").
# Still worth setting explicitly in production for a stable, predictable
# callback URL rather than relying on whatever host Vercel routes through.
# Required for local dev if you want OAuth sign-in to work against
# localhost (Auth.js needs SOME base URL to build the callback from
# before a real request has arrived).
#   Local:      http://localhost:3000
#   Production: https://<your-deployed-domain>
AUTH_URL=http://localhost:3000

# GitHub OAuth App credentials (lib/auth/config.ts GitHub provider —
# Auth.js reads these two env var names automatically for the "github"
# provider id, no explicit clientId/clientSecret wiring needed in code).
# Create one at https://github.com/settings/applications/new:
#   Application name:          Rewind (or "Rewind (dev)" for a local-only app)
#   Homepage URL:               AUTH_URL's value above
#   Authorization callback URL: <AUTH_URL>/api/auth/callback/github
# A production deployment needs its OWN OAuth App (a different callback
# URL than localhost) — don't reuse the same Client ID/Secret across
# environments.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
